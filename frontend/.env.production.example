# ─────────────────────────────────────────────────────────────────────────────
# Frontend — production environment variables
#
# Vite reads VITE_* variables at BUILD TIME (not runtime) and inlines them
# into the compiled bundle. On Render, render.yaml injects these variables
# during the static-site build step, so this file is reference documentation
# only — you do not need to create a real .env on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API.
# Accepted forms (the frontend normalizes all three):
#   - Full URL:    https://cscvs-backend.onrender.com/api/v1
#   - Bare host:   cscvs-backend.onrender.com
#   - host:port:   cscvs-backend.onrender.com:443
# Render injects this automatically from the backend service.
VITE_API_URL=https://cscvs-backend.onrender.com/api/v1

# Default department shown in the UI on login. Must match a department id
# that exists in the database (seeded by backend/src/db/seed.js).
VITE_DEPT_ID=SWE-DEPT

# Default semester label shown in the UI.
VITE_SEMESTER=251
