# ─────────────────────────────────────────────────────────────────────────────
# Backend — production environment variables
#
# On Render, every variable below is injected automatically by render.yaml.
# You do NOT need to create a .env file on the server; this file is reference
# documentation only. Keep it in version control so future maintainers know
# what the backend expects in production.
# ─────────────────────────────────────────────────────────────────────────────

# Tells the app to enable production-grade logging (morgan 'combined') and
# disables verbose query debugging.
NODE_ENV=production

# Port the Express server listens on. Render injects this automatically;
# 10000 is the documented fallback for free-tier web services.
PORT=10000

# Secret used to sign JSON Web Tokens. Render generates a random value
# automatically (generateValue: true) on first deploy. Never reuse the dev
# secret in production. Anyone with this value can forge tokens.
JWT_SECRET=replace_with_a_long_random_string

# Browser origin allowed to call this API. Render injects this from the
# frontend service. May be a full URL (https://...) or a bare host[:port];
# the backend normalizes it. Multiple origins can be separated with commas.
CORS_ORIGIN=https://cscvs-frontend.onrender.com

# PostgreSQL connection details. Render injects all five values from the
# managed Postgres database (cscvs-db) defined in render.yaml. SSL is enabled
# automatically by the code whenever DB_HOST is not localhost/127.0.0.1.
DB_HOST=<render-postgres-host>
DB_PORT=5432
DB_NAME=scheduler_db
DB_USER=scheduler_user
DB_PASSWORD=<render-generated-password>
