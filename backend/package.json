{
  "name": "scheduler-backend",
  "version": "1.0.0",
  "description": "Course Schedule Conflict Visualization System – Backend API",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "lsof -ti:${PORT:-4000} | xargs kill -9 2>/dev/null ; nodemon src/index.js",
    "dev:fresh": "npm run dev",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "SKIP_TEST_DB=1 jest tests/unit --runInBand --forceExit",
    "test:int": "NODE_ENV=test jest tests/integration --runInBand --forceExit",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "node src/db/migrate.js rollback",
    "seed": "node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
